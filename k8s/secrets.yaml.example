apiVersion: v1
kind: Secret
metadata:
  name: ${APP_NAME}-secrets
  namespace: ${APP_NAME}
  labels:
    app: ${APP_NAME}
type: Opaque
stringData:
  SUPABASE_URL: "troque-aqui"
  SUPABASE_KEY: "troque-aqui"
  JWT_SECRET: "troque-aqui"
  ANTHROPIC_API_KEY: "troque-aqui"
  GPTMAKER_API_TOKEN: "troque-aqui"
  GPTMAKER_AGENT_ID: "troque-aqui"
  GPTMAKER_WORKSPACE_ID: "troque-aqui"
  POWER_AUTOMATE_WEBHOOK_URL: "troque-aqui"
